{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.hsbl-ko-gyo.com/schemas/repo-seo-actions.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "owner", "sourceCollectedAt", "actions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "owner": { "const": "HSBL-ko-gyo" },
    "sourceCollectedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "actions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "repo"],
            "properties": {
              "type": { "const": "repository-metadata" },
              "repo": { "$ref": "#/definitions/repo" },
              "description": { "type": "string", "minLength": 1, "maxLength": 160 },
              "topics": {
                "type": "array",
                "maxItems": 12,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,49}$" }
              },
              "homepage": { "type": "string", "pattern": "^https://" }
            },
            "anyOf": [
              { "required": ["description"] },
              { "required": ["topics"] },
              { "required": ["homepage"] }
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "repo", "path", "baseSha", "content"],
            "properties": {
              "type": { "const": "readme-managed-intro" },
              "repo": { "$ref": "#/definitions/repo" },
              "path": { "$ref": "#/definitions/readmePath" },
              "baseSha": { "$ref": "#/definitions/sha" },
              "content": { "type": "string", "minLength": 1, "maxLength": 1200 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "repo", "path", "baseSha", "from", "to"],
            "properties": {
              "type": { "const": "readme-exact-url-repair" },
              "repo": { "$ref": "#/definitions/repo" },
              "path": { "$ref": "#/definitions/readmePath" },
              "baseSha": { "$ref": "#/definitions/sha" },
              "from": { "type": "string", "pattern": "^https://" },
              "to": { "type": "string", "pattern": "^https://" }
            }
          }
        ]
      }
    }
  },
  "definitions": {
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}$" },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "readmePath": { "type": "string", "pattern": "^(?:[^/]+/)*README(?:\\.[A-Za-z0-9._-]+)?$" }
  }
}
