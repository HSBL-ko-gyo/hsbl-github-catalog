---
import { getCollection } from "astro:content";
import ProjectCard from "../components/ProjectCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  GITHUB_COLLECTED_AT,
  GITHUB_COLLECTED_AT_DISPLAY,
} from "../lib/github-collection";
import { CATEGORIES, SITE } from "../lib/site";
import { isPublishedProject, sortProjects } from "../lib/project-schema";

const projects = sortProjects(
  await getCollection("projects", isPublishedProject),
);
const categoryCounts = Object.fromEntries(
  Object.keys(CATEGORIES).map((category) => [
    category,
    projects.filter(({ data }) => data.category === category).length,
  ]),
);
const title = `作ったもの | ${SITE.name}`;
const description =
  "ハシビロ工業で作った電子工作、基板設計ツール、ブラウザツール、Web作品をまとめています。";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  url: `${SITE.origin}/`,
  mainEntity: projects.map(({ data }, position) => ({
    "@type": "ListItem",
    position: position + 1,
    url: `${SITE.origin}/projects/${data.slug}/`,
    name: data.title,
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  pathname="/"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <p class="kicker">HSBL-KO-GYO / GITHUB</p>
        <h1>作ったもの、置いてます。</h1>
        <p class="hero-copy">
          電子工作、基板設計まわりのツール、ブラウザで使う小物など。GitHubや公開Webサービスにいろいろ埋まってきたので、何に使うものか分かる形で並べ直しました。
        </p>
      </div>
      <aside class="hero-note" aria-label="公開作品数">
        <strong>{projects.length}</strong>
        <span>個、公開中</span>
        <p>古いやつも試作もあります。使えそうなものだけどうぞ。</p>
        <p class="collection-time">
          GitHub情報取得: <time datetime={GITHUB_COLLECTED_AT}
            >{GITHUB_COLLECTED_AT_DISPLAY}</time>
        </p>
      </aside>
    </div>
  </section>

  <section class="section" aria-labelledby="catalog-heading">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="kicker">SEARCH</p>
          <h2 id="catalog-heading">作ったものを探す</h2>
        </div>
        <p>名前が分からなくても、やりたいことから探せます。</p>
      </div>

      <div class="filter-panel" aria-label="作品の絞り込み">
        <div class="filters">
          <div class="field">
            <label for="project-search">検索</label>
            <input
              id="project-search"
              type="search"
              placeholder="例：Markdownの表をPNGにしたい"
              autocomplete="off"
            />
          </div>
          <div class="field">
            <label for="category-filter">種類</label>
            <select id="category-filter">
              <option value="">すべてのカテゴリ</option>
              {
                Object.entries(CATEGORIES)
                  .filter(([slug]) => categoryCounts[slug] > 0)
                  .map(([slug, category]) => (
                    <option value={slug}>{category.label}</option>
                  ))
              }
            </select>
          </div>
          <div class="field">
            <label for="status-filter">状態</label>
            <select id="status-filter">
              <option value="">すべての状態</option>
              <option value="public">公開中</option>
              <option value="beta">ベータ</option>
              <option value="development">開発中</option>
              <option value="archived">アーカイブ</option>
            </select>
          </div>
        </div>
        <p class="result-count" aria-live="polite">
          <span id="visible-count">{projects.length}</span>件を表示
        </p>
      </div>

      <div class="project-grid" id="project-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
      <p id="no-results" class="empty-message" hidden>
        見つかりませんでした。検索語か絞り込みを変えてください。
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="category-heading">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="kicker">CATEGORIES</p><h2 id="category-heading">
            種類で見る
          </h2>
        </div>
      </div>
      <div class="category-grid">
        {
          Object.entries(CATEGORIES)
            .filter(([slug]) => categoryCounts[slug] > 0)
            .map(([slug, category]) => (
              <a class="category-card" href={`/categories/${slug}/`}>
                <h3>
                  {category.label} <small>{categoryCounts[slug]}</small>
                </h3>
                <p>{category.description}</p>
              </a>
            ))
        }
      </div>
    </div>
  </section>

  <script>
    const searchInput =
      document.querySelector<HTMLInputElement>("#project-search");
    const categorySelect =
      document.querySelector<HTMLSelectElement>("#category-filter");
    const statusSelect =
      document.querySelector<HTMLSelectElement>("#status-filter");
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>("[data-project-card]"),
    );
    const visibleCount = document.querySelector<HTMLElement>("#visible-count");
    const noResults = document.querySelector<HTMLElement>("#no-results");

    const normalize = (value: string) =>
      value.normalize("NFKC").toLocaleLowerCase("ja").trim();
    const update = () => {
      const query = normalize(searchInput?.value ?? "");
      const category = categorySelect?.value ?? "";
      const status = statusSelect?.value ?? "";
      let count = 0;
      for (const card of cards) {
        const matches =
          (!query || normalize(card.dataset.search ?? "").includes(query)) &&
          (!category || card.dataset.category === category) &&
          (!status || card.dataset.status === status);
        card.hidden = !matches;
        if (matches) count += 1;
      }
      if (visibleCount) visibleCount.textContent = String(count);
      if (noResults) noResults.hidden = count !== 0;
    };

    searchInput?.addEventListener("input", update);
    categorySelect?.addEventListener("change", update);
    statusSelect?.addEventListener("change", update);
  </script>
</BaseLayout>
