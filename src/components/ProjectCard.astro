---
import type { CollectionEntry } from "astro:content";
import {
  projectPublicationLabel,
  projectPublishedAt,
} from "../lib/project-schema";
import { CATEGORIES, STATUS_LABELS } from "../lib/site";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data } = project;
const searchText = [
  data.title,
  data.summary,
  data.category,
  data.primaryLanguage,
  ...data.tags,
  ...data.searchIntents,
]
  .join(" ")
  .toLocaleLowerCase("ja");
const isExternal = data.sourceType === "external";
const publishedAt = projectPublishedAt(data);
const publishedDate = new Intl.DateTimeFormat("ja-JP", {
  dateStyle: "medium",
  timeZone: "Asia/Tokyo",
}).format(new Date(publishedAt));
---

<article
  class="project-card"
  data-project-card
  data-search={searchText}
  data-category={data.category}
  data-status={data.status}
>
  {
    data.thumbnail && (
      <a class="card-thumbnail" href={`/projects/${data.slug}/`} tabindex="-1" aria-hidden="true">
        <img src={data.thumbnail} alt="" width="880" height="495" loading="lazy" />
      </a>
    )
  }
  <div class="card-topline">
    <span class="category-label">{CATEGORIES[data.category].label}</span>
    {data.isFork && <span class="fork-label">FORK版</span>}
    {isExternal && <span class="source-label">WEB公開</span>}
    <span class:list={["status-label", `status-${data.status}`]}
      >{STATUS_LABELS[data.status]}</span
    >
  </div>
  <h2><a href={`/projects/${data.slug}/`}>{data.title}</a></h2>
  <p>{data.summary}</p>
  <div class="card-meta">
    <span>{data.primaryLanguage ?? (isExternal ? "Webサービス" : "未判定")}</span>
    <span>{projectPublicationLabel(data)}: {publishedDate}</span>
  </div>
  <div class="card-actions">
    <a class="button button-primary" href={`/projects/${data.slug}/`}>見る</a>
    {
      data.links.app && (
        <a class="text-link" href={data.links.app}>
          ブラウザで使う
        </a>
      )
    }
    {
      data.links.github && (
        <a class="text-link" href={data.links.github}>GitHub</a>
      )
    }
  </div>
</article>
