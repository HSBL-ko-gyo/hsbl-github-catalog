---
import type { CollectionEntry } from "astro:content";
import { CATEGORIES, STATUS_LABELS } from "../lib/site";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data } = project;
const searchText = [data.title, data.summary, data.category, data.primaryLanguage, ...data.tags, ...data.searchIntents]
  .join(" ")
  .toLocaleLowerCase("ja");
---

<article
  class="project-card"
  data-project-card
  data-search={searchText}
  data-category={data.category}
  data-status={data.status}
>
  <div class="card-topline">
    <span class="category-label">{CATEGORIES[data.category].label}</span>
    <span class:list={["status-label", `status-${data.status}`]}>{STATUS_LABELS[data.status]}</span>
  </div>
  <h2><a href={`/projects/${data.slug}/`}>{data.title}</a></h2>
  <p>{data.summary}</p>
  <div class="card-meta">
    <span>主な言語: {data.primaryLanguage ?? "未判定"}</span>
    {data.createdYear && <span>{data.createdYear}年〜</span>}
  </div>
  <div class="card-actions">
    <a class="button button-primary" href={`/projects/${data.slug}/`}>詳しく見る</a>
    {data.links.app && <a class="text-link" href={data.links.app}>ブラウザで使う</a>}
    <a class="text-link" href={data.links.github}>GitHub</a>
  </div>
</article>
