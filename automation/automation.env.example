# Installed as ~/.config/hsbl-github-catalog/automation.env with mode 0600.
# Keep credentials and browser profile contents outside this repository.
HSBL_CATALOG_CDP_URL=http://127.0.0.1:9222
HSBL_CATALOG_STATE_DIR=__HOME__/.local/state/hsbl-github-catalog/protopedia
HSBL_CHROME_BIN=/usr/bin/chromium
